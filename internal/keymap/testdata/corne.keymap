// Sample Corne (42 keys, two encoders) keymap for the ZMK Editor tests.
// Colemak-DH base with home row mods, numbers and navigation layers, an
// adjust layer reached through both, and a plain gaming layer.
// Written in the multi-line, leading-comma style some configs use.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&sk {
  /delete-property/ ignore-modifiers;
};

/ {
  combos {
    compatible = "zmk,combos";

    escape {
      bindings = <&kp ESC>;
      key-positions = <1 2>;
    };
    ent {
      bindings = <&kp RET>;
      key-positions = <20 21>;
    };
    bspc {
      bindings = <&kp BSPC>;
      key-positions = <9 10>;
    };
    del {
      bindings = <&kp DEL>;
      key-positions = <33 34>;
      layers = <0 4>;
    };
    tab_combo {
      bindings = <&kp TAB>;
      key-positions = <14 15>;
      timeout-ms = <40>;
    };
    capsword {
      bindings = <&caps_word>;
      key-positions = <16 19>;
    };
    boot_combo {
      bindings = <&bootloader>;
      key-positions = <0 11>;
      layers = <3>;
    };
  };

  macros {
    gg: good_game {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings = <&kp G &kp G &kp SPACE>;
    };
    lyr_rgb: layer_with_color {
      compatible = "zmk,behavior-macro-two-param";
      #binding-cells = <2>;
      wait-ms = <0>;
      tap-ms = <0>;
      bindings
        = <&macro_param_2to2>
        , <&rgb_ug RGB_COLOR_HSB_CMD MACRO_PLACEHOLDER>
        , <&macro_press>
        , <&macro_param_1to1>
        , <&mo MACRO_PLACEHOLDER>
        , <&macro_pause_for_release>
        , <&macro_release>
        , <&macro_param_1to1>
        , <&mo MACRO_PLACEHOLDER>
        ;
    };
    wctl: with_ctrl {
      compatible = "zmk,behavior-macro-one-param";
      #binding-cells = <1>;
      bindings
        = <&macro_press>
        , <&kp LCTRL>
        , <&macro_tap>
        , <&macro_param_1to1>
        , <&kp MACRO_PLACEHOLDER>
        , <&macro_release>
        , <&kp LCTRL>
        ;
    };
  };

  behaviors {
    hrm_l: home_row_mod_left {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      bindings = <&kp>, <&kp>;
      flavor = "balanced";
      tapping-term-ms = <220>;
      quick-tap-ms = <150>;
      hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
    };
    hrm_r: home_row_mod_right {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      bindings = <&kp>, <&kp>;
      flavor = "balanced";
      tapping-term-ms = <220>;
      quick-tap-ms = <150>;
      hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
    };
    td_shift: shift_or_caps {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      tapping-term-ms = <180>;
      bindings = <&kp LSHFT>, <&caps_word>;
    };
    enc_vol: encoder_volume {
      compatible = "zmk,behavior-sensor-rotate";
      #sensor-binding-cells = <0>;
      bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
    };
    enc_rgb: encoder_lighting {
      compatible = "zmk,behavior-sensor-rotate-var";
      #sensor-binding-cells = <2>;
      bindings = <&rgb_ug>, <&rgb_ug>;
    };
  };

  conditional_layers {
    compatible = "zmk,conditional-layers";

    num_nav_adjust {
      if-layers = <1 2>;
      then-layer = <3>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    base {
      display-name = "Colemak";
      bindings = <
        &kp ESC       &kp Q          &kp W          &kp F          &kp P          &kp B                                &kp J        &kp L          &kp U          &kp Y          &kp SEMI       &kp BSLH
        &td_shift     &hrm_l LGUI A  &hrm_l LALT R  &hrm_l LCTRL S &hrm_l LSHFT T &kp G                                &kp M        &hrm_r RSHFT N &hrm_r RCTRL E &hrm_r RALT I  &hrm_r RGUI O  &kp SQT
        &kp LCTRL     &kp Z          &kp X          &kp C          &kp D          &kp V                                &kp K        &kp H          &kp COMMA      &kp DOT        &kp FSLH       &kp RSHFT
                                                    &kp LGUI       &lyr_rgb 1 RGB_COLOR_HSB_VAL(30,90,60) &kp SPACE    &kp RET      &lyr_rgb 2 RGB_COLOR_HSB_VAL(200,80,60) &kp BSPC
      >;

      sensor-bindings = <&enc_vol>, <&enc_rgb RGB_HUI RGB_HUD>;
    };

    num {
      display-name = "Numbers";
      bindings = <
        &trans        &kp N1         &kp N2         &kp N3         &kp N4         &kp N5                               &kp N6       &kp N7         &kp N8         &kp N9         &kp N0         &kp MINUS
        &trans        &kp EXCL       &kp AT         &kp HASH       &kp DLLR       &kp PRCNT                            &kp CARET    &kp AMPS       &kp STAR       &kp LPAR       &kp RPAR       &kp EQUAL
        &trans        &kp GRAVE      &kp TILDE      &kp LBKT       &kp RBKT       &wctl C                              &wctl V      &kp LBRC       &kp RBRC       &kp PIPE       &kp PLUS       &kp UNDER
                                                    &trans         &trans         &trans                               &trans       &mo 3          &trans
      >;

      sensor-bindings = <&enc_vol>, <&enc_rgb RGB_BRI RGB_BRD>;
    };

    nav {
      display-name = "Navigation";
      bindings = <
        &trans        &kp HOME       &kp PG_UP      &kp UP         &kp PG_DN      &kp END                              &kp C_VOL_UP &kp C_PREV     &kp C_PP       &kp C_NEXT     &kp PSCRN      &trans
        &trans        &kp LGUI       &kp LEFT       &kp DOWN       &kp RIGHT      &kp INS                              &kp C_VOL_DN &kp RSHFT      &kp RCTRL      &kp RALT       &kp RGUI       &trans
        &trans        &wctl Z        &wctl X        &wctl C        &wctl V        &gg                                  &kp C_MUTE   &kp DEL        &trans         &trans         &trans         &trans
                                                    &trans         &mo 3          &trans                               &trans       &trans         &trans
      >;
    };

    adjust {
      display-name = "Adjust";
      bindings = <
        &bootloader   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_CLR                           &rgb_ug RGB_TOG &rgb_ug RGB_EFF &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_BRI &bootloader
        &none         &none          &none          &none          &none          &none                                &none        &rgb_ug RGB_EFR &rgb_ug RGB_HUD &rgb_ug RGB_SAD &rgb_ug RGB_BRD &none
        &sys_reset    &none          &none          &none          &none          &tog 4                               &tog 4       &none          &none          &none          &none          &sys_reset
                                                    &trans         &trans         &trans                               &trans       &trans         &trans
      >;
    };

    game {
      display-name = "Game";
      bindings = <
        &kp TAB       &kp Q          &kp W          &kp E          &kp R          &kp T                                &trans       &trans         &trans         &trans         &trans         &trans
        &kp LSHFT     &kp A          &kp S          &kp D          &kp F          &kp G                                &trans       &trans         &trans         &trans         &trans         &trans
        &kp LCTRL     &kp Z          &kp X          &kp C          &kp V          &kp B                                &trans       &trans         &trans         &trans         &trans         &tog 4
                                                    &kp LALT       &kp SPACE      &kp SPACE                            &trans       &trans         &trans
      >;
    };
  };
};
