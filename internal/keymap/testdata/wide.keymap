// Sample: a large keyboard with irregular rows, an older `label`
// property style, behaviors pulled in from other files and overrides of
// built-in behaviors.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    tapping-term-ms = <220>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        #include "extra_macros.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        wrap_parens: wrap_parens {
            compatible = "zmk,behavior-macro";
            label = "wrap_parens";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp RPAR>, <&kp LEFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1  &kp N2  &kp N3  &kp N4  &tog 1                                    &mo 3      &kp N6  &kp N7  &kp N8     &kp N9    &kp MINUS
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp LA(SLASH)                             &kp LC(K)  &kp Y   &kp U   &kp I      &kp O     &kp BSLH
&kp ESC    &hm LCTRL A  &kp S  &kp D  &kp F  &kp LC(P)  &kp LCTRL  &kp LALT  &kp LGUI  &kp RCTRL  &kp H  &kp J  &kp K  &hm RCTRL L  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V             &kp HOME  &kp PG_UP             &kp N   &kp M   &kp COMMA  &kp DOT   &kp RSHFT
&mo 2      &kp GRAVE  &wrap_parens  &kp LEFT  &kp BSPC  &kp DEL  &kp END  &kp PG_DN  &kp RET  &kp SPACE  &kp UP  &kp DOWN  &ext_macro  &mo 2
            >;
        };

        keypad {
            display-name = "Keypad";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                       &mo 3   &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                       &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_ENTER
&trans  &trans  &trans  &trans  &trans          &trans  &trans                       &kp KP_N0  &trans  &trans  &kp KP_DOT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &tog 1                                       &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans                                       &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp CAPS  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp C_VOL_UP  &kp C_VOL_DN  &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none                  &trans  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &bootloader                                       &bootloader  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &bt BT_CLR  &none            &none  &none  &none  &none  &none
&none  &none  &none  &none  &none          &none  &out OUT_USB                       &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &out OUT_BLE  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
